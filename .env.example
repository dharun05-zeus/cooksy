# Copy to .env and fill in. Never commit .env, and never put a real key in this file.

# Where downloaded and processed data live (default: ./data)
RECIPEBOT_DATA_DIR=data

# LLM used to understand messages: auto (Gemini if a key is set, else rules) | gemini | rules
LLM_PROVIDER=auto
# Free key from https://aistudio.google.com (Get API key), in a project without billing
GEMINI_API_KEY=
# Any free-tier Gemini text model; change it if Google renames models
GEMINI_MODEL=gemini-3.6-flash
