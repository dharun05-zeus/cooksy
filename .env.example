# Optional: copy to .env to change these defaults. Never commit .env.

# Where downloaded and processed data live (default: ./data)
RECIPEBOT_DATA_DIR=data

# LLM used to understand messages: ollama (default; falls back to the offline rule parser
# if Ollama is not running) | none (offline rule parser only)
LLM_PROVIDER=ollama
# Ollama model (pull it first: ollama pull qwen3:4b)
OLLAMA_MODEL=qwen3:4b
# LLM-written opening sentence for each reply: off (default; slow on a CPU) | on
LLM_SUMMARIES=off
