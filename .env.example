# Copy to .env and fill in. Never commit .env, and never put a real key in this file.

# Where downloaded and processed data live (default: ./data)
RECIPEBOT_DATA_DIR=data

# LLM used to understand messages: auto (local Ollama if running, else Groq, else Gemini if
# a key is set, else the offline rule parser) | ollama | groq | gemini | none
LLM_PROVIDER=auto
# Ollama model (pull it first: ollama pull qwen3:4b)
OLLAMA_MODEL=qwen3:4b
# Free key from https://console.groq.com/keys (no card needed)
GROQ_API_KEY=
# Any model listed at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# Free key from https://aistudio.google.com (Get API key), in a project without billing
GEMINI_API_KEY=
# Any free-tier Gemini text model; change it if Google renames models
GEMINI_MODEL=gemini-3.6-flash
# LLM-written opening sentence for each reply: auto (on for Gemini, off for local models) | on | off
LLM_SUMMARIES=auto
